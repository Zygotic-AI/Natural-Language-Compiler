# .gitignore

# OS / editor
.DS_Store
Thumbs.db
*~
*.swp
.idea/
.vscode/
!.vscode/extensions.json

# Env / secrets
.env
.env.*
!.env.example
*.pem
credentials.json

# Dependencies / build (when tools land)
node_modules/
dist/
build/
coverage/
.turbo/
.cache/
*.tsbuildinfo

# Python (when tools land)
__pycache__/
.venv/
venv/
*.egg-info/

# Release prepare observation cache (rebuilt by the release executor)
.nlc/release-prepare-facts.json

# Local install hub bytes (ADR 0060). The lock file stays committable.
.nlc/hub
.nlc/versions/
.nlc/current

# Root session artifacts (must not be committed)
/in-process
/agent

# Logs
*.log
npm-debug.log*
